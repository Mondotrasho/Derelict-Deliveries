  banner: {fileID: 21300000, guid: d599b65b82cc06d4fa3c976437dea8e7, type: 3}
  shortDescription: A sealed life capsule drifts past, its beacon long dead. Something
    might still be inside.
  allowLeave: 1
  choices:
  - id: scrap
    text: Scrap it for supplies
    availability:
      tags: []
      flags: []
      counters: []
    showWhenLocked: 0
    lockedReason: 
    showOdds: 1
    outcomes:
    - label: Salvaged
      weight: 85
      resultText: You strip the frame and pull out the power cells.
      resources:
      - kind: 3
        amount: 8
      writes:
        tags: []
        flags: []
        counters: []
      consumeAsteroid: 0
      followUp: {fileID: 0}
    - label: Explosion
      weight: 15
      resultText: A ruptured cell ignites as you cut. The blast scorches your hull.
      resources:
      - kind: 1
        amount: -10
      writes:
        tags: []
        flags: []
        counters: []
      consumeAsteroid: 0
      followUp: {fileID: 0}
    dialogue: {fileID: 0}
    endsEvent: 1
    hideAfterUse: 1
  - id: shoot
    text: Shoot it
    availability:
      tags: []
      flags: []
      counters: []
    showWhenLocked: 0
    lockedReason: 
    showOdds: 1
    outcomes:
    - label: Destroyed
      weight: 100
      resultText: One burst and the capsule is gone. Whatever was inside stays a
        mystery.
      resources: []
      writes:
        tags:
        - scope: 0
          tag: capsule:shot
          mustHave: 1
        flags: []
        counters: []
      consumeAsteroid: 0
      followUp: {fileID: 0}
    dialogue: {fileID: 0}
    endsEvent: 1
    hideAfterUse: 1
  - id: open
    text: Open it
    availability:
      tags: []
      flags: []
      counters: []
    showWhenLocked: 0
    lockedReason: 
    showOdds: 1
    outcomes:
    - label: Survivor
      weight: 60
      resultText: A half-frozen survivor stumbles out and joins your crew.
      resources:
      - kind: 2
        amount: 1
      writes:
        tags: []
        flags: []
        counters: []
      consumeAsteroid: 0
      followUp: {fileID: 0}
    - label: Dead crew
      weight: 30
      resultText: Only a body inside. You take what little it carried.
      resources:
      - kind: 3
        amount: 2
      writes:
        tags: []
        flags: []
        counters: []
      consumeAsteroid: 0
      followUp: {fileID: 0}
    - label: Parasite
      weight: 10
      resultText: Something bursts from the body and takes one of your crew before
        you can vent it.
      resources:
      - kind: 2
        amount: -1
      writes:
        tags: []
        flags: []
        counters: []
      consumeAsteroid: 0
      followUp: {fileID: 0}
    dialogue: {fileID: 0}
    endsEvent: 1
    hideAfterUse: 1
